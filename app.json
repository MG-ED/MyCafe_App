{
  "expo": {
    "name": "MyCAFE",
    "slug": "MyCAFE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MyCafe_Logo.png",
    "scheme": "mycafe",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/MyCafe_Logo.png",
        "backgroundImage": "./assets/MyCafe_Logo.png",
        "monochromeImage": "./assets/MyCafe_Logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/MyCafe_Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/MyCafe_Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
