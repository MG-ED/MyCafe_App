{
  "expo": {
    "name": "MyCAFE",
    "slug": "MyCAFE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "scheme": "mycafe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycafe.pos"
    },
    "android": {
      "package": "com.mycafe.pos",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "monochromeImage": "./assets/Logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "react-native-reanimated"
    ],
    "extra": {
      "googleWebClientId": "465844142916-20d1vkepbovt7p8nrra0v127vq106052.apps.googleusercontent.com",
      "googleAndroidClientId": "465844142916-e4porib0dpeon6ihbf64evvh7v0v8n82.apps.googleusercontent.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "09dae096-878d-4ebb-bb32-0b4940942dc1"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
