{
  "expo": {
    "name": "MyCAFE",
    "slug": "MyCAFE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MyCafe_Logo.png",
    "scheme": "mycafe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mycafe.pos",
      "googleServicesFile": "./google-services.json",
      "newArchEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/MyCafe_Logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/MyCafe_Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/MyCafe_Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "googleWebClientId": "465844142916-20d1vkepbovt7p8nrra0v127vq106052.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "465844142916-e4porib0dpeon6ihbf64evvh7v0v8n82.apps.googleusercontent.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "09dae096-878d-4ebb-bb32-0b4940942dc1"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/09dae096-878d-4ebb-bb32-0b4940942dc1"
    }
  }
}
